# Hub settings. Copy to .env and fill in:  cp .env.example .env
# Lines starting with # are notes. Values must be on their own line.

# Required: the database password. Make one with:  openssl rand -hex 16
POSTGRES_PASSWORD=

# Required: the hub's network address. CampNeuron opens snapshot links with it,
# so it must NOT be localhost.
HUB_PUBLIC_URL=http://HUB-IP-HERE:8100

# Time zone used for alert times sent to CampNeuron
SITE_TZ=Asia/Dubai

# CampNeuron's kafka (host:port). Leave commented out to use the hub's own test kafka.
#KAFKA_BOOTSTRAP=
#KAFKA_TOPIC=safety.alerts

# Defaults: leave these commented out in production.
# The pilot sets NODE_DOWN_AFTER_S=90 and EVIDENCE_MAX_GB=3 (test values, small disk).
#NODE_DOWN_AFTER_S=120
#EVIDENCE_KEEP_DAYS=30
#EVIDENCE_MAX_GB=20
#EVENTS_KEEP_DAYS=90

# The hub's own name in alerts ("Hub health"), and its disk alert threshold (0 = off)
#HUB_ID=hub
#HUB_DISK_WARN_GB=2
